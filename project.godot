; Engine configuration file.
; It's best edited using the editor if possible.

config_version=5

[application]
config/name="Rogue Side Mobile"
run/main_scene="res://scenes/MainMobile.tscn"
config/features=PackedStringArray("4.2", "mobile")
config/icon="res://icon.svg"

[autoload]
EventBus="*res://scripts/autoload/EventBus.gd"
GameManager="*res://scripts/autoload/GameManager.gd"

[display]
window/size/viewport_width=540
window/size/viewport_height=960
window/handheld/orientation="portrait"
window/stretch/mode="canvas_items"
window/stretch/aspect="keep_size"

[input]
